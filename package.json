{
  "name": "sat-prep-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first SAT prep app (Version 1) — personalized practice, forced error logs, spaced repetition, and progress tracking for Reading & Writing and Math.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "import": "tsx scripts/import/index.ts",
    "import:dry": "tsx scripts/import/index.ts --dry-run",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "katex": "0.16.11",
    "next": "14.2.33",
    "openai": "4.73.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-katex": "3.0.1",
    "recharts": "2.13.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/node": "20.16.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-katex": "3.0.4",
    "autoprefixer": "10.4.20",
    "pdfjs-dist": "4.7.76",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
