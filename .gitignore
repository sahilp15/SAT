# ---- SAT app: local data is private and not redistributed ----
# Local SQLite database (your personal progress)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# Uploaded source question PDFs (College Board content — do NOT commit/redistribute)
/data/uploads/*
!/data/uploads/.gitkeep

# Intermediate parsed question JSON (derived from copyrighted content)
/data/imported/*
!/data/imported/.gitkeep

# Extracted question figures
/public/question-assets/*
!/public/question-assets/.gitkeep
