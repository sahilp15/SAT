# ----------------------------------------------------------------------------
# SAT Prep App — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# Local SQLite database location (relative to the prisma/ directory).
# This is the ONLY variable you need. No API key is required — the app ships
# with a preloaded Math question bank and works fully offline.
DATABASE_URL="file:./dev.db"

# ----------------------------------------------------------------------------
# OPTIONAL — AI error-log review (leave blank to skip entirely).
# The app works completely without this. If you leave OPENAI_API_KEY blank,
# the error-log step just uses a "complete reflection" gate instead of AI
# feedback. Nothing else changes. No key is ever needed to practice.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_ENABLED="true"
