# ----------------------------------------------------------------------------
# SAT Studio — environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`; it is
# already in .gitignore. No real key should ever appear in this file.
# ----------------------------------------------------------------------------

# REQUIRED — local SQLite database location (relative to the prisma/ directory).
# This is the only variable the app needs. Everything below is optional.
DATABASE_URL="file:./dev.db"


# ----------------------------------------------------------------------------
# OPTIONAL — OpenAI-powered analysis.
#
# The app is fully functional without a key: the diagnostic, scoring, mistake
# analysis, error log, recommendations, study plan, and practice all run on
# local logic. A key adds the AI tutor, deeper mistake write-ups, AI review of
# error-log reflections, and the daily coaching note.
#
# SECURITY: the key is read only inside server-side code — src/lib/ai/config.ts
# is the single place `process.env.OPENAI_API_KEY` is touched. It is never sent
# to the browser, never written to the database, never logged, and never
# included in an API response; error messages are sanitized before they leave
# the server.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=""

# Model used for every AI call. gpt-4o-mini is a good cost/quality balance and
# supports the structured outputs this app relies on.
OPENAI_MODEL="gpt-4o-mini"

# Master kill switch. Set to "false" to disable every AI call regardless of the
# key. There is also a per-user toggle on the Settings page.
AI_ENABLED="true"


# ----------------------------------------------------------------------------
# OPTIONAL — AI reliability and cost controls. The values shown are the
# defaults the app uses when these are unset.
# ----------------------------------------------------------------------------

# Hard timeout for a single request, in milliseconds.
OPENAI_TIMEOUT_MS="20000"

# Retries after a retryable failure (429 / 5xx / timeout), with exponential backoff.
OPENAI_MAX_RETRIES="2"

# Cap on tokens generated per request — the primary cost lever.
OPENAI_MAX_OUTPUT_TOKENS="900"

# Rolling per-minute request ceiling.
OPENAI_MAX_REQUESTS_PER_MINUTE="20"

# Hard daily request ceiling. Once hit, AI features return their offline
# fallbacks until the window resets; nothing else is affected.
OPENAI_MAX_REQUESTS_PER_DAY="400"

# How long identical AI responses are cached in memory, in milliseconds.
# Mistake analyses and daily coaching notes are cached, so re-reading a page
# costs nothing.
OPENAI_CACHE_TTL_MS="3600000"
