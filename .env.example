# ----------------------------------------------------------------------------
# SAT Prep App — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# Local SQLite database location (relative to the prisma/ directory).
DATABASE_URL="file:./dev.db"

# ----------------------------------------------------------------------------
# AI (OpenAI) — used ONLY in server-side API routes (src/app/api/ai/*).
# The key is read on the server and is NEVER exposed to the browser.
# Leave this blank to run the app without AI: the error-log gate still
# enforces a complete reflection, it just won't get AI-quality review.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=""

# Model used for error-log review, study plans, and feedback.
# Any chat-capable OpenAI model id works; this is a sensible default.
OPENAI_MODEL="gpt-4o-mini"

# Master switch. Set to "false" to hard-disable all AI calls even if a key
# is present (useful for offline study sessions).
AI_ENABLED="true"
